# Telegram bot token and user whitelist are configured in WebUI → Adapters → adapter-telegram
# (persisted in the adapter volume; optional override: ADAPTER_CONFIG_PATH in the service env).

# LLM upstream URL, API keys, and model ids are not configured in this root .env;
# use WebUI → LLM → {component} or PUT via orchestrator `/api/v1/llm-components/{name}/config`.
# Optional override when running llm-openai outside compose (default in image: /data/llm-config.json):
# LLM_CONFIG_PATH=/data/llm-config.json

# Service ports
ORCHESTRATOR_PORT=18080
SESSION_PORT=18090
LLM_OPENAI_PORT=18081
USER_DOCKER_MANAGER_PORT=18082
ADAPTER_TELEGRAM_PORT=18084
RUNTIME_PORT=18085
SKILLS_PORT=18093
# Skills package root on volume skills_data (packages live under $SKILLS_ROOT/packages/{slug}/)
SKILLS_ROOT=/data
SKILLS_INDEX_PATH=/data/.index/index.db
SKILLS_LEGACY_DB_PATH=/data/skills.db
LOGGER_PORT=18086
STATS_PORT=18092
MEMORY_PORT=18087
# Memory encryption key (hex 64 chars). Leave empty to auto-generate on first start (persisted to volume).
MEMORY_SECRET_KEY=
WORKSPACE_PORT=18088
WEBUI_PORT=18000

# ReAct loop cap (runtime → llm-openai tool rounds)
REACT_MAX_STEPS=16
# Per-step completion token budget (covers reasoning/thinking tokens + answer)
RUNTIME_MAX_TOKENS=4096
# When a healthy skills service is registered: inject top FTS hits into the model context (1=on, 0=off)
RUNTIME_SKILLS_INJECT=1
RUNTIME_SKILLS_TOP_K=2
# Runtime plan gate: classifier (default) = JSON gate + mutating tool intercept; legacy_keyword = old keyword-only plan-first
# RUNTIME_PLAN_GATE=classifier

# Orchestrator upstream timeout when proxying long runtime/tool calls (seconds)
ORCHESTRATOR_UPSTREAM_TIMEOUT_SEC=240

# llm-openai per-invoke upstream budget (seconds); raise for slow local models
# that re-ingest long prompts (e.g. 180)
LLM_INVOKE_TIMEOUT_SEC=60

# Telegram adapter timeout for /api/v1/chat round trip (seconds)
ADAPTER_TELEGRAM_CHAT_TIMEOUT_SEC=240

# adapter-webui: web-based chat interface port
ADAPTER_WEBUI_PORT=18083
# adapter-webui timeout for /api/v1/chat round trip (seconds)
ADAPTER_WEBUI_CHAT_TIMEOUT_SEC=240

# Component liveness: a component is healthy while its last heartbeat
# (periodic re-registration, every 10s) is within this many seconds.
HEARTBEAT_TTL_SEC=30

# Shared secret for userdocker node tunnels (user-docker-manager dials the
# orchestrator with this token). CHANGE IT before exposing the orchestrator
# port to the internet; empty disables the tunnel endpoint entirely.
NODE_TOKEN=whalebot-node-token

# Node name of the local user-docker-manager (must be unique per machine;
# lowercase [a-z0-9_.-]). Container names are addressed as "<node>/<name>".
NODE_NAME=local

# Session cap (messages kept per session_id)
SESSION_MAX_MESSAGES=40

# Session idle timeout: if no new messages for this many seconds, the session is marked expired
SESSION_IDLE_SEC=86400

# userdocker: temporary (session_scoped) container removal if untouched for this long (seconds).
# If unset, defaults to USERDOCKER_IDLE_HOURS * 3600.
USERDOCKER_TEMP_TTL_SEC=

# userdocker idle sweeper tick (still used)
USERDOCKER_IDLE_HOURS=24
USERDOCKER_IDLE_CHECK_SEC=300

# framework-managed image allowlist (comma-separated)
USERDOCKER_ALLOWED_IMAGES=whalebot/userdocker-base:latest,whalebot/userdocker-golang:latest
